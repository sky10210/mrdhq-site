rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn(){ return request.auth != null; }
    function isOwner(uid){ return signedIn() && request.auth.uid == uid; }
    function isTeacher(){ return signedIn() && (
      request.auth.token.email == "skyler.dipasquale@casdonline.org" ||
      request.auth.token.email == "elijah.snyder@casdonline.org" ||
      request.auth.token.email == "max.jamelli@casdonline.org" ||
      request.auth.token.email == "sldipasquale@gmail.com"
    ); }
    match /stockLabUsers/{uid} {
      allow read: if isOwner(uid) || isTeacher();
      allow create: if isOwner(uid);
      allow update: if isOwner(uid) || isTeacher();
      allow delete: if isTeacher();
      match /{document=**} { allow read: if isOwner(uid) || isTeacher(); allow write: if isOwner(uid) || isTeacher(); }
    }
    match /stockLabMarket/{snapshotId} { allow read: if signedIn(); allow write: if isTeacher(); }\n    match /stockLabMarketPrices/{companyId} { allow read: if signedIn(); allow write: if isTeacher(); }
    match /stockLabPriceHistory/{document=**} { allow read: if signedIn(); allow write: if isTeacher(); }
    match /stockLabCompanies/{companyId} { allow read: if signedIn(); allow write: if isTeacher(); }
    match /stockLabIndustries/{industryId} { allow read: if signedIn(); allow write: if isTeacher(); }
    match /stockLabInnovationCategories/{categoryId} { allow read: if signedIn(); allow write: if isTeacher(); }
    match /stockLabSchools/{schoolId} { allow read: if signedIn(); allow write: if isTeacher(); }
    match /stockLabTeachers/{teacherId} { allow read: if signedIn(); allow write: if isTeacher(); }
    match /stockLabSubjects/{subjectId} { allow read: if signedIn(); allow write: if isTeacher(); }
    match /stockLabClasses/{classId} { allow read: if signedIn(); allow write: if isTeacher(); }
    match /stockLabEvents/{eventId} { allow read: if signedIn(); allow write: if isTeacher(); }
    match /stockLabDailySnapshots/{document=**} { allow read: if signedIn(); allow write: if isTeacher(); }
    match /{document=**} { allow read, write: if false; }
  }
}
